bring local:database/objects/post

// Joy's router is quite similar to NextJS app router

// The View or Island named "Page" from the file having the same name as the parent folder (except for index.joy) will be given the pageload
View Page(str permalink->vPermalink) {
    maybe<Post> post = db.posts.first(post => post.permalink == permalink)
    defuse post {
        some(Post(str title->vPostTitle, str body)) => expose title, body
        noth => notFound()
    }
    return <p>Post post post at {permalink}... {title} and {body} <UserAgent/></p>
}

// This client-side Island component is supposed to display user's device information
Island UserAgent() {
    str ua = js.execute(code: /*The code that returns the UA*/)
    str browser = getBrowserNameFromUA(ua) // Imagine it's implemented somewhere nearby

    return <p>Your browser is {browser}</p>
}

// localStorage("key") returns maybe<str>, defuse it normally
Island PersistentStorage() {
    maybe<str> lastVisit = localStorage("abcd")

    defuse lastVisit {
        some(str date) => {
            maybe<str> writeResult = localStorage("abcd", date())

            defuse writeResult {
                some(_) => celebrate()
                noth => panic()
            }
        }
        noth => forbidden()
    }
}

// Validator functions are regular Joy functions prefixed with 'v'.
// A parameter annotated ->vName means: run vName on the passed value before
// entering the function body. If the validator returns a noth/error variant,
// it propagates to the caller. The function body can assume the value is valid.
// Validators can also accept configuration: ->vMaxLength(1000) passes 1000 as
// a second argument to the validator function.
