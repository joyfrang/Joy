bring local:database/objects/post

Joy's router is quite similar to NextJS app router. <~
The View or Island named "Page" from the file having the same name as the parent folder <~
(except for index.joy) will be given the pageload. <~
View Page(str requestedPermalink) {
    maybe<Post> post = query(db.posts) {
        where(permalink == requestedPermalink)
        first()
    }
    defuse(post) {
        some(Post(str title, str body)) => expose title, body
        noth => notFound()
    }
    return <p>Post post post at {requestedPermalink}... {title} and {body} <UserAgent/></p>
}

Island UserAgent() { ~> displays user's device information — already client-side as it returns an Island
    str ua = js.execute(code: ~>> Code that returns the UA <<~)
    str browser = getBrowserNameFromUA(ua) ~> imagine it's implemented somewhere nearby

    return <p>Your browser is {browser}</p>
}

Island PersistentStorage() { ~> localStorage("key") returns maybe<str>, defuse it normally
    maybe<str> lastVisit = localStorage("abcd")

    defuse(lastVisit) {
        some(str date) => {
            maybe<str> writeResult = localStorage("abcd", date())

            defuse(writeResult) {
                some(_) => celebrate()
                noth => panic()
            }
        }
        noth => forbidden()
    }
}
