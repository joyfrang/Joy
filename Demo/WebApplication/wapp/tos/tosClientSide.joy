This file is the implementation of the Terms of Service page. <~
The code runs on the client-side; the browser handles managing state. <~
Island Page() {
    bucket<str> tosBody = ()
    maybe<str> userLocale = localStorage("userLocale")

    defuse userLocale {
        some(str locale) => {
            server(tosBody, bring locale) {
                str tos = getTosForLocale(locale)
                return tos
            }
        }
        noth => forbidden()
    }

    return <div>
            <h1>Terms of Service</h1>
            <Wait for={tosBody(10s) as str tos} ~> Wait is the equivalent of Suspense in React
                  fallback={<p>Loading...</p>}
                  timeout={<p>Sorry, we are having trouble loading the terms of service.</p>}>

                <p>{tos}</p>
            </Wait>
        </div>
}
