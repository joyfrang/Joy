thing Post {
    Post(
        u5 id,
        str title,
        str body->vMaxLength(1000),
        str date,
        str author,
        str permalink->vPermalink
    )
}

// The config block declares how this thing maps to a database table.
// Only fields that need non-default behavior are listed.
// All other fields are persisted using their field name as the column name.
config joy:database/table Post {
    table: "posts"
    id: primaryKey, autoIncrement
    date: dbDate
    permalink: unique
}

// The config block declares serialization behavior for JSON.
// Only fields that deviate from defaults are listed.
// By default, all fields serialize using their field name as the JSON key.
config joy:json/object Post {
    id: ignore
    title: key("PostTitle")
}

// Contracts are the same as Interfaces or Traits in other languages
cont ThingThatGetsStoredInDatabase {
    bit isPublic()
    bit isUserContent(bit isFromEu)
}

// The impl keyword is used to implement a contract for a thing.
// Instance methods take 'self' as their first parameter, typed as the thing.
// They are called as post.isPublic(), post.isUserContent(isFromEu: true), etc.
impl Post:ThingThatGetsStoredInDatabase {
    bit isPublic(Post self) {
        return true
    }

    bit isUserContent(Post self, bit isFromEu) {
        if(isFromEu) {
            return true
        }

        return false
    }
}

// impl without a contract adds instance methods directly to the thing.
impl Post {
    noth delete(Post self) {
        // Implementation to delete the post from the database
    }
}
