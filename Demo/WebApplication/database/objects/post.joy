thing Post {
    Post(
        u5 id,
        str title,
        str body->vMaxLength(1000),
        str date,
        str author,
        str permalink->vPermalink
    )
}

~> Declares how this thing maps to a database table.
~> Only fields that need non-default behavior are listed.
~> All other fields are persisted using their field name as the column name.
setup joy:database/table Post {
    table: "posts"
    id: primaryKey, autoIncrement
    date: dbDate
    permalink: unique
}

~> Declares JSON serialization behavior.
~> Only fields that deviate from defaults are listed.
~> By default, all fields serialize using their field name as the JSON key.
setup joy:json/object Post {
    id: ignore
    title: key("PostTitle")
}

cont ThingThatGetsStoredInDatabase { ~> contracts are the same as Interfaces or Traits in other languages
    bit isPublic()
    bit isUserContent(bit isFromEu)
}

~> Instance methods take 'self' as their first parameter, typed as the thing.
~> Called as post.isPublic(), post.isUserContent(isFromEu: true), etc.
impl Post:ThingThatGetsStoredInDatabase {
    bit isPublic(Post self) {
        return true
    }

    bit isUserContent(Post self, bit isFromEu) {
        if(isFromEu) {
            return true
        }

        return false
    }
}

impl Post { ~> impl without a contract adds instance methods directly to the thing
    noth delete(Post self) {
        ~> implementation to delete the post from the database
    }
}
