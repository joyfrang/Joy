bring local:settings

expose bit isValid() {
    settings() is a system function returning the type of the settings, <~
    specified in bundle.joy — figures out everything at compile-time <~
    maybe<str> something = settings().licenseKey
    return 1
}

noth arrays() {
    bit[] bits = [1, 0, 1] ~> dynamically sized array
    bit[...] moreBits = [1, 0, 0, 1] ~> equivalent to bit[4]
    bit[100] evenMore = [1] ~> room for appending without resizing

    maybe<bit> firstTrue = bits.where(b == 1).first() ~> we have Linq!

    for(bit b in bits) {
        do something with b <~
    }

    ints and unsigned ints are powers of two <~
    u5 is 2^5 = 32 bit unsigned integer <~
    for((bit b, u5 i) in bits) {
        do something with it <~
    }
}

noth fn() {
    str licenseKey = settings().licenseKey
}
