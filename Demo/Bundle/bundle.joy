bring local:settings // When bringing a local file, function calls need to be like settings.functionName(),
// But `thing`s can be used without prefixing them with the bundle name

// Bundles are configured via a `load` function that returns a settings `thing`.
// This function is called when the bundle is brought into a project,
// allowing for dynamic configuration.
Settings load(str licenseKey) {
    return (licenseKey: licenseKey, apiKey: "def")
}

noth testFunction() {
    dict<i5, str> numbers = [
        1: "one",
        2: "two",
        3: "three",
        4: "four",
        5: "five",
        6: "six",
        7: "seven",
        8: "eight",
        9: "nine",
        10: "ten",
    ]
}
